# --- secrets: never commit keyrings, private keys or env files -------------
.env
.env.*
!.env.example
.gnupg/
**/gpg-backup/
**/gpg-restore/
**/private-keys-v1.d/
*.key
*.rev
*.kbx
*.kbx~
trustdb.gpg
random_seed
*.pem
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
*deploy_key*
*.npmrc
# MFA recovery codes the app lets a person download (aigh-recovery-codes.txt)
aigh-recovery-codes*.txt

# --- database dumps and exports (personal data; keep in backup storage) -----
*.dump
*.backup
*.sql.gz
*.bak
*.bak-*

# --- backup drill output (large opaque binaries; keep in backup storage) ----
*.tar.gz.gpg
*.gpg

# --- runtime document storage (local development) ---------------------------
backend/storage/

# --- generated --------------------------------------------------------------
node_modules/
dist/
coverage/
*.tsbuildinfo
backend/src/generated/

# --- logs -------------------------------------------------------------------
*.log

# --- local scratch scripts (one leaked a database URL: backend/.mk.cjs) -----
# Dot-prefixed one-off scripts are never project code; keep them out of Git.
.*.js
.*.cjs
.*.mjs
.*.ts
.*.cts
.*.mts
.scratch/

# --- test and tool output ---------------------------------------------------
playwright-report/
test-results/
.vite/
*.tgz

# --- editors and operating systems -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
