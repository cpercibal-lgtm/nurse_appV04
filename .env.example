# AIGH Nursing Workforce v0.1.0 — backend environment. Copy to backend/.env.
# Every variable is validated at startup (backend/src/config/env.ts).

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Matches docker-compose.yml (development only). On a PostgreSQL server that also
# hosts V03, do NOT use "nurseapp": that is V03's database. Use a separate one, e.g.
# nurseapp_v04, owned by the V04 login (V04 must never touch the legacy data).
DATABASE_URL=postgresql://aigh:aigh_dev_only@localhost:5432/nurseapp
# With the database roles of ops/db/README.md (required in production), DATABASE_URL
# is the nurseapp_runtime login and migrations use this one instead:
# MIGRATION_DATABASE_URL=postgresql://nurseapp_migration:<password>@localhost:5432/nurseapp_v04
# Separate, migrated database for integration tests. Tests add uniquely named rows
# and leave them (the audit trail is append-only), so the database grows; drop and
# re-create it (then db:deploy) whenever convenient. Never point it at real data.
TEST_DATABASE_URL=postgresql://aigh:aigh_dev_only@localhost:5432/nurseapp_test

# ── Authentication (spec §3.3, §3.4; decision D-6) ────────────────────────────
# Signing key for access tokens: at least 32 characters of random data.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min (spec §3.4)
SESSION_IDLE_SECONDS=3600           # 1 h without refresh ends the session (spec §3.3)
SESSION_ABSOLUTE_SECONDS=86400      # 24 h absolute boundary (spec §3.3/§3.4)
BCRYPT_ROUNDS=12                    # spec §3.4
# ── MFA (spec §3.5, decision D-51) ────────────────────────────────────────────
# Roles that must use an authenticator app, comma-separated, or "none".
# Production refuses a list without SYSTEM_ADMIN and HR_ADMIN.
MFA_REQUIRED_ROLES=SYSTEM_ADMIN,HR_ADMIN,SUPERVISOR,NURSING_ADMIN,NURSING_DIRECTOR
# Encrypts the authenticator secrets: 32 random bytes, base64. Required in
# production; keep it with the backups — without it every authenticator must be
# set up again. Generate with:  openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# ── Document vault (spec §5.3.1, decision D-53) ───────────────────────────────
# Wraps each stored document's own encryption key: 32 random bytes, base64,
# different from MFA_ENCRYPTION_KEY. Required in production; keep it with the
# backup keys — the stored documents cannot be read without it.
# Generate with:  openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=
# ── PDPL sensitive fields (spec §8.3.4, decision D-54) ────────────────────────
# Iqama, passport and SCFHS numbers are encrypted with a key per employee,
# wrapped by PDPL_FIELD_ENCRYPTION_KEY, and found through an HMAC keyed with
# PDPL_BLIND_INDEX_PEPPER. Both required in production, both different from
# every other key; keep them with the backup keys. openssl rand -base64 32
PDPL_FIELD_ENCRYPTION_KEY=
PDPL_BLIND_INDEX_PEPPER=
# Key rotation (B-18, docs/DEPLOYMENT.md "Rotating a key"): only while replacing a
# key, the old value goes here beside the new one until npm run keys:rotate is done.
# MFA_ENCRYPTION_KEY_PREVIOUS=
# DOCUMENT_ENCRYPTION_KEY_PREVIOUS=
# PDPL_FIELD_ENCRYPTION_KEY_PREVIOUS=
# PDPL_BLIND_INDEX_PEPPER_PREVIOUS=
# Login attempt limits — spec §3.3 requires them but sets no numbers
# (REQUIREMENT NOT ESTABLISHED). Implementation defaults; confirm with hospital IT.
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_MAX_PER_ACCOUNT=5
# Failed attempts per network address in the window. Staff sign in over mobile internet
# (hospital reply D1, 2026-10-14): carriers can put many unrelated users behind one address,
# so the default of 20 can pause sign-in for a whole shift. The per-account limit above is
# what stops guessing; on the production server set 100 in /etc/nurseapp/app.env.
LOGIN_THROTTLE_MAX_PER_CLIENT=20
# ── Uploads (spec §5.1.5, §5.3.2; decision D-10) ────────────────────────────
STORAGE_DIR=./storage
# Days a database backup is kept — the same value as the backup kit's BACKUP_RETENTION_DAYS.
# An erasure (D-55, spec §8.3.3) records when the last backup holding the erased data expires.
BACKUP_RETENTION_DAYS=30
UPLOAD_MAX_SIZE_BYTES=10485760
# dev-magic-bytes: files are marked CLEAN after size and magic-byte checks
# (development only). clamav: every upload is streamed to clamd (INSTREAM) before
# it is stored; required in production. Local clamd: docker compose --profile clamav up -d
UPLOAD_SCANNER=dev-magic-bytes
CLAMAV_HOST=                        # required when UPLOAD_SCANNER=clamav, e.g. clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000             # per clamd call; 3 attempts, then the upload fails (503)
CLAMAV_MAX_SIGNATURE_AGE_HOURS=48   # older signatures log a "clamav signatures are stale" error

# ── E-mail (spec §7.2; D-47: the hospital SMTP relay) ─────────────────────────
# Empty SMTP_HOST = e-mail off: notifications stay in-app (e-mail status SKIPPED).
# STARTTLS is required on 587 (never plain text); SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=                          # from the deployment secrets, never committed
SMTP_FROM=                          # e.g. "AIGH Workforce <nurseapp@aigh.sa>"
SMTP_REPLY_TO=                      # a monitored HR mailbox
SMTP_TLS_REJECT_UNAUTHORIZED=true   # must stay true in production
SMTP_RETRY_MAX=8
SMTP_RETRY_DELAY_SECONDS=60
# D-69: most e-mails sent in any 60 minutes; 0 = no limit. UltaMail allows 200 per
# hour per domain: set 150 there. Mail over it waits (PENDING), outbox and urgent first.
EMAIL_HOURLY_LIMIT=0
# APP_BASE_URL=https://nurse.aigh.sa   # links in e-mails; defaults to CORS_ORIGIN
# Spec §3.6: e-mailed when the break-glass account signs in (CEO, IT Director).
BREAK_GLASS_ALERT_EMAILS=

# Telegram (D-66; replaces SMS). mock: messages are kept in the Dev Console
# Telegram inbox (Administration → Telegram inbox) and never sent — works offline.
# telegram: the Bot API; needs the token and username from @BotFather.
# Messages never carry personal data (Telegram is outside the Kingdom).
NOTIFICATION_DRIVER=mock
TELEGRAM_BOT_TOKEN=                 # from the deployment secrets, never committed
TELEGRAM_BOT_USERNAME=              # without "@", e.g. aigh_nursing_bot
# Spec §3.6: messaged when the break-glass account signs in (CEO, IT Director): Telegram chat ids, comma-separated.
BREAK_GLASS_ALERT_TELEGRAM_CHAT_IDS=
# How the bot receives /start (account linking): polling (the jobs process
# long-polls Telegram; no public address needed) or webhook (the API registers
# APP_BASE_URL/api/v1/telegram/webhook and needs TELEGRAM_WEBHOOK_SECRET:
# at least 32 of A-Z a-z 0-9 _ -, e.g. `openssl rand -hex 32`).
TELEGRAM_UPDATES=polling
TELEGRAM_WEBHOOK_SECRET=            # from the deployment secrets, never committed

# SCFHS licence checks (D-64). mock: answered by the simulated registry in the
# Dev Console. live: the SCFHS verification API (not built yet; needs the SCFHS
# agreement, U3) with the URL and key below. off: nothing is checked. Unset: off
# in production (the simulated registry would answer "not found" for every real
# licence), mock elsewhere. In production set mock only on a demonstration server.
SCFHS_DRIVER=mock
SCFHS_API_URL=
SCFHS_API_KEY=                      # from the deployment secrets, never committed

# Simulated badge events from the Dev Console (D-65). Unset: off in production,
# on elsewhere. on in production only for a demonstration, then clear and turn off.
# BADGE_SIMULATOR=off

# true only behind the reverse proxy (so the client IP is the real client).
TRUST_PROXY=false

# Background jobs: in-process (development — the API runs them), worker
# (production — run `npm run worker` separately and set this on the API), off.
JOBS_MODE=in-process

# ── Demo fixtures (development only: npm run fixtures:demo -w backend) ────────
# There is no seed. Hospital data enters through `npm run bootstrap` and the
# baseline import (docs/DATABASE_ARCHITECTURE.md §7). The demo fixtures load
# demo logins (admin@, hr.admin@, supervisor@, nurse@, breakglass@aigh.sa) and
# fictional staff into an EMPTY database named *_dev / *_test / *_demo only.
# 12–72 characters (spec §3.2). Never set in production.
DEMO_PASSWORD=

# ── Data residency (spec §8.3, fail-closed) ───────────────────────────────────
# KSA regions only. NEVER list AWS me-south-1 (Bahrain) or me-central-1 (UAE).
# Examples: me-jeddah-1, me-riyadh-1 (Oracle), me-central-2 (Google Dammam),
# ksa-onprem (hospital data centre). "local" is accepted outside production only.
DATA_RESIDENCY_REGION=local
PDPL_ALLOWED_REGIONS=local
