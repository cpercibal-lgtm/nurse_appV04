{
  "name": "@aigh/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/jobs/worker.js",
    "bootstrap": "node dist/cli/bootstrap.js",
    "vault:encrypt": "node dist/cli/vault-encrypt.js",
    "pdpl:protect": "node dist/cli/pdpl-protect.js",
    "pdpl:reerase": "node dist/cli/pdpl-reerase.js",
    "keys:rotate": "node dist/cli/keys-rotate.js",
    "mfa": "node dist/cli/mfa-dev.js",
    "exit:package": "node dist/cli/exit-package.js",
    "fixtures:demo": "tsx test/fixtures/demo/cli.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/fhir": "0.0.44",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "@types/yazl": "3.3.1",
    "prisma": "7.10.0",
    "smtp-server": "3.19.17",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
