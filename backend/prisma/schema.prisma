// AIGH Nursing Workforce Management System — V04 authoritative schema.
//
// One schema, one migration chain (prisma migrate). Constraints Prisma cannot
// express (exclusion constraint, partial unique indexes, CHECKs, the full-name
// trigger, fn_append_audit_entry) live in hand-written SQL inside the same
// migrations — see prisma/migrations/*/migration.sql.
//
// Conventions: models PascalCase, fields camelCase, tables/columns snake_case.
// Calendar dates use @db.Date; instants use timestamptz.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════════════════
//  Identity & access  (spec §3.3, §3.6, §8)
// ════════════════════════════════════════════════════════════════════════════

enum AppRole {
  SYSTEM_ADMIN
  HR_ADMIN
  SUPERVISOR
  // EMPLOYEE is implicit for every active user and is never stored (rule R1).
}

enum ScopeType {
  SYSTEM
  DEPARTMENT
  UNIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  WITHDRAWN
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  /// The break-glass root account (spec §3.6): bypasses PAM and four-eyes, triggers the siren.
  isBreakGlass Boolean   @default(false) @map("is_break_glass")
  /// Links a login to the nurse record it may see as "own" (spec §8.1 Employee column).
  employeeId   Int?      @unique @map("employee_id")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  /// D-66: the Telegram chat this account is messaged in, set by /start <token>; null = not linked.
  telegramChatId   String?   @unique @map("telegram_chat_id")
  telegramLinkedAt DateTime? @map("telegram_linked_at") @db.Timestamptz
  /// D-68, development only: never asked for a second step, whatever the role requires. Set and
  /// cleared by `npm run mfa -w backend -- off|on <email|id>`; ignored with NODE_ENV=production.
  mfaExempt        Boolean   @default(false) @map("mfa_exempt")

  employee           Employee?                   @relation(fields: [employeeId], references: [id])
  sessions           RefreshSession[]
  roleAssignments    RoleAssignment[]            @relation("assignee")
  grantedAssignments RoleAssignment[]            @relation("granter")
  revokedAssignments RoleAssignment[]            @relation("revoker")
  approvalsInitiated ApprovalRequest[]           @relation("initiator")
  approvalsDecided   ApprovalRequest[]           @relation("approver")
  privilegedSession  PrivilegedSession?
  invitationsIssued  Invitation[]                @relation("issuer")
  invitationClaimed  Invitation?                 @relation("claimant")
  passwordResets     PasswordReset[]             @relation("resetFor")
  resetsIssued       PasswordReset[]             @relation("resetIssuer")
  notifications      Notification[]
  mfaFactor          MfaFactor?
  mfaRecoveryCodes   MfaRecoveryCode[]
  mfaChallenges      MfaChallenge[]
  downloadLinks      DownloadLink[]
  telegramLinks       TelegramLinkToken[] @relation("telegramLinkOwner")
  telegramLinksIssued TelegramLinkToken[] @relation("telegramLinkIssuer")
  emailChanges        EmailChange[]       @relation("emailChangeFor")
  emailChangesIssued  EmailChange[]       @relation("emailChangeIssuer")
  dsrRequested       DataSubjectRequest[]        @relation("dsrRequester")
  dsrReviewed        DataSubjectRequest[]        @relation("dsrReviewer")
  dsrDecided         DataSubjectRequest[]        @relation("dsrDecider")
  registerSignOffs   ProcessingRegisterSignOff[]
  logicPromoted      EligibilityLogicVersion[]   @relation("logicPromoter")
  announcements      Announcement[]              @relation("announcementCreator")
  announcementsEnded Announcement[]              @relation("announcementCanceller")
  logicRetired       EligibilityLogicVersion[]   @relation("logicRetirer")
  shadowDecisions    EligibilityShadowLog[]
  apiClientsCreated  ApiClient[]                 @relation("apiClientCreator")
  apiClientsRevoked  ApiClient[]                 @relation("apiClientRevoker")

  @@map("users")
}

model RefreshSession {
  id                String    @id // opaque id carried in the cookie
  userId            Int       @map("user_id")
  tokenHash         String    @map("token_hash") // sha256 of the secret; raw value never stored
  familyId          String    @map("family_id") // reuse of a rotated token revokes the family
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz // idle limit, renewed on rotation
  /// Absolute session boundary, copied unchanged through every rotation (spec §3.3).
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Where the sign-in or refresh came from — shown only to the account owner (D-22).
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

/// Scoped, time-boxed grant of an application role (spec §8, rules R1–R12).
/// SQL: partial unique (user_id, role, scope_type) WHERE revoked_at IS NULL;
///      CHECK scope_type = 'SYSTEM' <=> cardinality(scope_ids) = 0.
model RoleAssignment {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  role              AppRole
  scopeType         ScopeType @map("scope_type")
  /// Department ids (DEPARTMENT) or unit ids (UNIT); empty for SYSTEM.
  scopeIds          Int[]     @map("scope_ids")
  reason            String
  grantedById       Int       @map("granted_by_id")
  grantedAt         DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  revokedById       Int?      @map("revoked_by_id")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason      String?   @map("revoke_reason")
  approvalRequestId Int?      @map("approval_request_id")

  user            User             @relation("assignee", fields: [userId], references: [id])
  grantedBy       User             @relation("granter", fields: [grantedById], references: [id])
  revokedBy       User?            @relation("revoker", fields: [revokedById], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  @@index([userId, revokedAt])
  @@index([role, scopeType])
  @@map("role_assignments")
}

/// Four-eyes request (spec §8.1, rules R10–R12).
/// SQL: partial unique (initiator_id, action_type) WHERE status = 'PENDING'.
model ApprovalRequest {
  id          Int            @id @default(autoincrement())
  initiatorId Int            @map("initiator_id")
  approverId  Int?           @map("approver_id")
  actionType  String         @map("action_type")
  payload     Json
  status      ApprovalStatus @default(PENDING)
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  decidedAt   DateTime?      @map("decided_at") @db.Timestamptz
  executedAt  DateTime?      @map("executed_at") @db.Timestamptz
  withdrawnAt DateTime?      @map("withdrawn_at") @db.Timestamptz

  initiator   User             @relation("initiator", fields: [initiatorId], references: [id])
  approver    User?            @relation("approver", fields: [approverId], references: [id])
  assignments RoleAssignment[]

  @@index([status])
  @@map("approval_requests")
}

/// PAM just-in-time elevation (spec §8.1, rule R13).
model PrivilegedSession {
  userId       Int      @id @map("user_id")
  reason       String
  elevatedAt   DateTime @default(now()) @map("elevated_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  authorizedBy Int?     @map("authorized_by")

  user User @relation(fields: [userId], references: [id])

  @@map("privileged_sessions")
}

/// Break-glass siren (spec §3.6, rule R18). Runtime role: INSERT/SELECT only.
model BreakGlassEvent {
  id          Int       @id @default(autoincrement())
  actorUserId Int       @map("actor_user_id")
  reason      String
  ipAddress   String    @map("ip_address")
  activatedAt DateTime  @default(now()) @map("activated_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz // activated_at + 4 h
  endedAt     DateTime? @map("ended_at") @db.Timestamptz

  @@map("break_glass_events")
}

// ════════════════════════════════════════════════════════════════════════════
//  Organisation & workforce  (spec §2.9, §3.1.1, §6.3)
// ════════════════════════════════════════════════════════════════════════════

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  nameAr      String?  @map("name_ar")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  units Unit[]

  @@map("departments")
}

/// SQL: CHECK (bed_count BETWEEN 0 AND 500)  (rule W4)
model Unit {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  nameAr       String?       @map("name_ar")
  description  String?
  departmentId Int           @map("department_id")
  bedCount     Int           @default(0) @map("bed_count")
  /// KPI A area (MoH Ada'a critical areas) — set by HR; replaces the unit-code map that was in kpi.ts.
  criticalArea CriticalArea? @map("critical_area")
  /// KPI B numerator: nurses rostered here count (MoH Ada'a excludes non-patient-care areas) — set by HR.
  patientCareArea Boolean    @default(true) @map("patient_care_area")
  /// KPI B denominator: this unit's beds are hospital operational (inpatient) beds — set by HR.
  inpatientBeds   Boolean    @default(false) @map("inpatient_beds")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  department             Department              @relation(fields: [departmentId], references: [id])
  employees              Employee[]
  bedCapacityLogs        BedCapacityLog[]
  coverageTargets        CoverageTarget[]
  credentialRequirements CredentialRequirement[]
  shiftAssignments       ShiftAssignment[]

  @@index([departmentId])
  @@map("units")
}

model BedCapacityLog {
  id            Int      @id @default(autoincrement())
  unitId        Int      @map("unit_id")
  previousCount Int      @map("previous_count")
  newCount      Int      @map("new_count")
  reason        String
  changedById   Int?     @map("changed_by_id") // null = seed / system
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId, changedAt])
  @@map("bed_capacity_logs")
}

/// Position directory (spec §3.1.1). Never confers an authorization role (R14).
model Position {
  code          String   @id
  title         String
  titleAr       String?  @map("title_ar")
  tier          String
  description   String?
  isSchedulable Boolean  @map("is_schedulable")
  /// Holders count as nurses in the nurse-to-bed KPIs (MoH Ada'a counts nurses only) — set by HR.
  countsAsNurse Boolean  @default(false) @map("counts_as_nurse")
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  /// A deprecated position names its successor (e.g. AHN -> ACTING_HEAD); history keeps the old code.
  replacedBy    String?  @map("replaced_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  replacement            Position?               @relation("PositionReplacement", fields: [replacedBy], references: [code], onDelete: Restrict)
  replaces               Position[]              @relation("PositionReplacement")
  employees              Employee[]
  credentialRequirements CredentialRequirement[]

  @@map("positions")
}

/// MoH Ada'a critical areas used by nurse-to-bed KPI A.
enum CriticalArea {
  ICU
  ER
  OR
}

enum ShiftType {
  Morning
  Evening
  Night
}

/// Configured minimum staff per unit per shift (spec L813, §6.3, rule W8).
/// No row = target "unspecified" — never treated as zero. No values are seeded:
/// staffing minimums are REQUIREMENT NOT ESTABLISHED until the hospital supplies them.
model CoverageTarget {
  id           Int       @id @default(autoincrement())
  unitId       Int       @map("unit_id")
  shiftType    ShiftType @map("shift_type")
  minimumStaff Int       @map("minimum_staff")
  updatedById  Int?      @map("updated_by_id")
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, shiftType])
  @@map("coverage_targets")
}

// ════════════════════════════════════════════════════════════════════════════
//  Nurse master  (spec §3.1)
// ════════════════════════════════════════════════════════════════════════════

enum MaritalStatus {
  Single
  Married
  Others
}

/// SQL: trigger trg_employees_compose_full_name (rule E3); CHECK salary >= 0.
model Employee {
  id                    Int            @id @default(autoincrement())
  jobNumber             String         @unique @map("job_number") // no format rule (E1)
  firstName             String         @map("first_name")
  middleName            String?        @map("middle_name")
  lastName              String         @map("last_name")
  fullName              String         @map("full_name") // derived by trigger — never supplied
  jobTitle              String?        @map("job_title")
  fileNo                String?        @map("file_no") // not unique (E8)
  /// Free text from before the Rank/Grade master (owner decision 2026-10-03): kept only where it
  /// matched no listed classification, so HR can choose the right one. New values never.
  rankGrade             String?        @map("rank_grade")
  rankGradeCode         String?        @map("rank_grade_code") @db.VarChar(20)
  /// Free text from before the nationality list (owner decision 2026-10-03): kept only where it
  /// could not be matched to a listed nationality, so HR can choose the right one. New values never.
  nationality           String?
  nationalityCode       String?        @map("nationality_code") @db.VarChar(3)
  /// Free text from before the Saudi location master (owner decision 2026-10-03): kept only where it
  /// matched no listed city, so HR can choose the right Region + City. New values never.
  jobPostLocation       String?        @map("job_post_location")
  jobPostRegionCode     String?        @map("job_post_region_code") @db.VarChar(10)
  /// Always a city of jobPostRegionCode (checked by the service).
  jobPostCityId         Int?           @map("job_post_city_id")
  /// Free text from before the Facility master (owner decision 2026-10-03): kept only where it
  /// matched no facility (e.g. wards such as "ICU Main"), so HR can choose one. New values never.
  actualWorkPlace       String?        @map("actual_work_place")
  facilityId            Int?           @map("facility_id")
  /// Free text from before the Nursing Specialty master (owner decision 2026-10-03): kept only
  /// where it matched no listed specialty, so HR can choose the right one. New values never.
  specialty             String?
  specialtyCode         String?        @map("specialty_code") @db.VarChar(20)
  maritalStatus         MaritalStatus? @map("marital_status")
  salary                Decimal?       @db.Decimal(12, 2) // SAR
  contactEmail          String         @map("contact_email")
  /// E.164, "+" and 8–15 digits (D-35). The employee may update both (self-service).
  primaryPhone          String?        @map("primary_phone") @db.VarChar(16)
  /// Next-of-kin number — third-party data: the employee and HR only, never the supervisor view (D-35).
  emergencyContactPhone String?        @map("emergency_contact_phone") @db.VarChar(16)
  /// null = Unassigned (replaces the V03 sentinel unit id 0).
  unitId                Int?           @map("unit_id")
  positionCode          String         @map("position_code")
  /// Employment status values beyond "Active" are REQUIREMENT NOT ESTABLISHED.
  status                String         @default("Active")
  hireDate              DateTime?      @map("hire_date") @db.Date
  deletedAt             DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  unit             Unit?                  @relation(fields: [unitId], references: [id])
  position         Position               @relation(fields: [positionCode], references: [code])
  nationalityRef   Nationality?           @relation(fields: [nationalityCode], references: [code], onDelete: Restrict)
  rankGradeRef     RankGrade?             @relation(fields: [rankGradeCode], references: [code], onDelete: Restrict)
  specialtyRef     NursingSpecialty?      @relation(fields: [specialtyCode], references: [code], onDelete: Restrict)
  jobPostRegion    SaudiRegion?           @relation(fields: [jobPostRegionCode], references: [code], onDelete: Restrict)
  jobPostCity      SaudiCity?             @relation(fields: [jobPostCityId], references: [id], onDelete: Restrict)
  facility         Facility?              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  user             User?
  driftFindings    ConsistencyAuditLog[]
  shadowFindings   EligibilityShadowLog[]
  invitations      Invitation[]
  contracts        Contract[]
  credentials      Credential[]
  waivers          CredentialWaiver[]
  eligibilityState EligibilityState?
  shiftAssignments ShiftAssignment[]
  attendanceEvents AttendanceEvent[]
  dataKey          EmployeeKey?
  subjectRequests  DataSubjectRequest[]
  scfhsChecks      ScfhsCheck[]

  @@index([unitId])
  @@index([positionCode])
  @@index([nationality])
  @@index([nationalityCode])
  @@index([rankGradeCode])
  @@index([specialtyCode])
  @@index([jobPostRegionCode])
  @@index([jobPostCityId])
  @@index([facilityId])
  @@index([specialty])
  @@index([fileNo])
  @@map("employees")
}

// ════════════════════════════════════════════════════════════════════════════
//  Contracts  (spec §4)
// ════════════════════════════════════════════════════════════════════════════

enum ContractStatus {
  Draft
  PendingApproval
  Approved
  Active
  Expired
  Suspended
  Terminated
  Superseded
}

/// SQL: EXCLUDE USING gist (employee_id WITH =, daterange(start_date, end_date, '[]') WITH &&)
///      WHERE (status IN ('Approved','Active'))  (rule C4);
///      CHECK end_date > start_date; CHECK Hijri shape.
model Contract {
  id             Int            @id @default(autoincrement())
  employeeId     Int            @map("employee_id")
  jobNumber      String         @map("job_number") // denormalised for traceability (spec §3.1)
  startDate      DateTime       @map("start_date") @db.Date // Gregorian — authoritative
  endDate        DateTime       @map("end_date") @db.Date
  startDateHijri String?        @map("start_date_hijri") @db.VarChar(10)
  endDateHijri   String?        @map("end_date_hijri") @db.VarChar(10)
  status         ContractStatus @default(Draft)
  /// Employment contract type (owner decision 2026-10-03). Required on new contracts and renewals;
  /// contracts created before the field existed stay NULL ("not classified").
  contractTypeCode String?      @map("contract_type_code") @db.VarChar(20)
  /// Who created and who submitted it: neither may approve it (owner decision D-30).
  createdById    Int?           @map("created_by_id")
  submittedById  Int?           @map("submitted_by_id")
  approvedById   Int?           @map("approved_by_id")
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  employee     Employee          @relation(fields: [employeeId], references: [id])
  contractType ContractType?     @relation(fields: [contractTypeCode], references: [code], onDelete: Restrict)
  documents    DocumentVersion[]

  @@index([employeeId, status])
  @@index([endDate])
  @@index([contractTypeCode])
  @@map("contracts")
}

/// Facility master (owner decision 2026-10-03): the hospitals an employee actually works in,
/// maintained by hospital-wide HR and System Admins. Names are stored trimmed with single spaces,
/// unique ignoring case (checked by the service). A used facility is deactivated, never deleted.
model Facility {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(150)
  nameAr    String?  @map("name_ar") @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("facilities")
}

/// Saudi Arabia location master (owner decision 2026-10-03): regions (ISO 3166-2 codes, SA-01 …)
/// and their cities, maintained on screen by hospital-wide HR and System Admins. Job Post (City) is
/// a region + one of its cities. Used records are deactivated, never deleted.
model SaudiRegion {
  code      String   @id @db.VarChar(10)
  name      String   @unique @db.VarChar(80)
  nameAr    String?  @map("name_ar") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cities    SaudiCity[]
  employees Employee[]

  @@map("saudi_regions")
}

model SaudiCity {
  id         Int      @id @default(autoincrement())
  regionCode String   @map("region_code") @db.VarChar(10)
  name       String   @db.VarChar(80)
  nameAr     String?  @map("name_ar") @db.VarChar(80)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  region    SaudiRegion @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  employees Employee[]

  @@unique([regionCode, name])
  @@map("saudi_cities")
}

/// Nursing Specialty master (owner decision 2026-10-03): NS001 Clinical Nursing … NS034 General /
/// Unspecified to start, maintained on screen by hospital-wide HR and System Admins, sorted by
/// sortOrder. Names are unique (also ignoring case, checked by the service). A used record is
/// deactivated, never deleted.
model NursingSpecialty {
  code        String   @id @db.VarChar(20)
  name        String   @unique @db.VarChar(120)
  nameAr      String?  @map("name_ar") @db.VarChar(120)
  description String?  @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("nursing_specialties")
}

/// Rank/Grade master (owner decision 2026-10-03): the SCFHS nursing classification (N01…),
/// maintained on screen by system-wide HR and System Admins. A used record is deactivated, never
/// deleted. The SCFHS licence's "classification" field draws on the same list.
model RankGrade {
  code      String   @id @db.VarChar(20)
  name      String   @db.VarChar(120)
  meaning   String?  @db.VarChar(300)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("rank_grades")
}

/// Nationalities (owner decision 2026-10-03): a fixed, standard list (ISO 3166-1 alpha-3, as on
/// passports) loaded by its migration; name is the nationality ("Saudi"), countryName the country.
model Nationality {
  code        String   @id @db.VarChar(3)
  name        String   @unique @db.VarChar(80)
  nameAr      String?  @map("name_ar") @db.VarChar(80)
  countryName String   @map("country_name") @db.VarChar(80)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("nationalities")
}

/// Employment contract types (owner decision 2026-10-03): a hospital-wide list that HR and System
/// Admins maintain on screen. A type no contract uses can be deleted; a used one is deactivated —
/// hidden from new contracts, still shown on the old ones. Information only: no eligibility rule reads it.
model ContractType {
  code         String   @id @db.VarChar(20)
  name         String   @db.VarChar(120)
  nameAr       String?  @map("name_ar") @db.VarChar(120)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contracts Contract[]

  @@map("contract_types")
}

// ════════════════════════════════════════════════════════════════════════════
//  Credentials  (spec §5)
// ════════════════════════════════════════════════════════════════════════════

enum CredentialStatus {
  PendingVerification
  Valid
  ExpiringSoon
  Expired
  Suspended
  Revoked
}

enum NationalityRule {
  ALL
  ONLY
  EXCEPT
}

enum PolicyStatus {
  MANDATORY
  TRANSITION
  OPTIONAL
}

enum SyncStatus {
  SYNCED
  STALE
  FAILED
  PENDING
}

model CredentialCategory {
  code         String  @id // IDENTITY | LICENSURE | LIABILITY | COMPETENCY | LIFE_SUPPORT
  name         String
  description  String?
  displayOrder Int     @default(0) @map("display_order")

  templates CredentialTemplate[]

  @@map("credential_categories")
}

/// SQL: CHECK (grace_period_days BETWEEN 0 AND 90)  (rule L8)
model CredentialTemplate {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  /// Arabic name shown in the Arabic interface (English name when empty).
  nameAr          String?  @map("name_ar") @db.VarChar(120)
  categoryCode    String   @map("category_code")
  description     String?
  hasExpiry       Boolean  @default(true) @map("has_expiry")
  requiresUpload  Boolean  @default(true) @map("requires_upload")
  gracePeriodDays Int      @default(0) @map("grace_period_days")
  displayOrder    Int      @default(0) @map("display_order")
  isActive        Boolean  @default(true) @map("is_active")
  /// Spec §5.4 (D-64): holders' licences are checked with SCFHS (needs a SCFHS_REG field).
  scfhsEnabled     Boolean  @default(false) @map("scfhs_enabled")
  /// SCFHS reporting SUSPENDED or REVOKED suspends the credential at once (otherwise HR is told).
  scfhsAutoSuspend Boolean  @default(false) @map("scfhs_auto_suspend")
  /// Owner decision 2026-10-04: who the type applies to. ALL; ONLY the listed nationalities; or EXCEPT them.
  /// For an employee it does not apply to, a requirement of the type counts as OPTIONAL (never blocks).
  nationalityRule  NationalityRule @default(ALL) @map("nationality_rule")
  nationalityCodes String[]        @default([]) @map("nationality_codes") @db.VarChar(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  category     CredentialCategory        @relation(fields: [categoryCode], references: [code])
  fields       CredentialTemplateField[]
  requirements CredentialRequirement[]
  credentials  Credential[]
  waivers      CredentialWaiver[]

  @@map("credential_templates")
}

enum CredentialFieldType {
  text
  date
  date_hijri
  select
  number
  country
  reference
}

/// One tracked field of a credential type (spec §5.1.3). `ordinal` keeps the
/// order the administrator gave; `key` is what credentials.tracking_data uses.
model CredentialTemplateField {
  id           Int                 @id @default(autoincrement())
  templateId   Int                 @map("template_id")
  ordinal      Int
  key          String
  label        String
  /// Arabic label shown in the Arabic interface (English label when empty).
  labelAr      String?             @map("label_ar") @db.VarChar(100)
  type         CredentialFieldType
  required     Boolean
  displayOrder Int                 @default(0) @map("display_order")
  isIssueDate  Boolean             @default(false) @map("is_issue_date")
  isExpiryDate Boolean             @default(false) @map("is_expiry_date")
  /// D-54: IQAMA | PASSPORT | SCFHS_REG — sensitive personal data (spec §8.3.1), encrypted and blind-indexed.
  pdplCategory String?             @map("pdpl_category")

  template CredentialTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, key])
  @@unique([templateId, ordinal])
  @@map("credential_template_fields")
}

/// A credential rule for a unit (spec §5.1.4: unit required); positionCode null =
/// every position in that unit. SQL: unique NULLS NOT DISTINCT.
model CredentialRequirement {
  id                 Int          @id @default(autoincrement())
  templateId         Int          @map("template_id")
  unitId             Int          @map("unit_id")
  positionCode       String?      @map("position_code")
  policyStatus       PolicyStatus @default(MANDATORY) @map("policy_status")
  transitionDeadline DateTime?    @map("transition_deadline") @db.Date
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  template CredentialTemplate @relation(fields: [templateId], references: [id])
  unit     Unit               @relation(fields: [unitId], references: [id])
  position Position?          @relation(fields: [positionCode], references: [code])

  @@unique([templateId, unitId, positionCode])
  @@map("credential_requirements")
}

model Credential {
  id               Int              @id @default(autoincrement())
  employeeId       Int              @map("employee_id")
  templateId       Int              @map("template_id")
  status           CredentialStatus @default(PendingVerification)
  issueDate        DateTime?        @map("issue_date") @db.Date
  expiryDate       DateTime?        @map("expiry_date") @db.Date
  expiryDateHijri  String?          @map("expiry_date_hijri") @db.VarChar(10)
  /// Template-defined tracked fields (e.g. scfhs_number). PII fields are candidates for §8.3 encryption.
  trackingData     Json             @default("{}") @map("tracking_data")
  /// Renewal staging (spec §5.2): replacement values awaiting HR review.
  pendingData      Json?            @map("pending_data")
  /// Current approved evidence (spec §5.1.5 latest_evidence_id).
  latestEvidenceId Int?             @unique @map("latest_evidence_id")
  verifiedById     Int?             @map("verified_by_id")
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz
  statusReason     String?          @map("status_reason")
  graceActivatedAt DateTime?        @map("grace_activated_at") @db.Timestamptz
  graceExpiryDate  DateTime?        @map("grace_expiry_date") @db.Date
  graceCycleId     String?          @map("grace_cycle_id") // prevents stacking (L8)
  syncStatus       SyncStatus?      @map("sync_status")
  lastSyncAt       DateTime?        @map("last_sync_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  employee        Employee              @relation(fields: [employeeId], references: [id])
  template        CredentialTemplate    @relation(fields: [templateId], references: [id])
  documents       DocumentVersion[]
  identifierIndex PdplIdentifierIndex[]
  scfhsChecks     ScfhsCheck[]
  latestEvidence  DocumentVersion?      @relation("latestEvidence", fields: [latestEvidenceId], references: [id])

  @@index([employeeId, status])
  @@index([expiryDate])
  @@map("credentials")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

/// Append-only versioned evidence for contracts and credentials (rules D1–D4).
/// SQL: CHECK exactly one of contract_id / credential_id is set.
model DocumentVersion {
  id           Int                  @id @default(autoincrement())
  contractId   Int?                 @map("contract_id")
  credentialId Int?                 @map("credential_id")
  version      Int
  fileName     String               @map("file_name")
  mimeType     String               @map("mime_type")
  sizeBytes    Int                  @map("size_bytes")
  sha256       String
  storageKey   String               @unique @map("storage_key") // never exposed as a URL
  scanStatus   ScanStatus           @default(PENDING) @map("scan_status")
  reviewStatus DocumentReviewStatus @default(PENDING_REVIEW) @map("review_status")
  reviewedById Int?                 @map("reviewed_by_id")
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz
  uploadedById Int?                 @map("uploaded_by_id")
  uploadedAt   DateTime             @default(now()) @map("uploaded_at") @db.Timestamptz
  /// Identity scan erased with the employee's data (spec §8.3.3, D-55): the stored object is removed; the row stays as the record.
  erasedAt     DateTime?            @map("erased_at") @db.Timestamptz

  contract      Contract?      @relation(fields: [contractId], references: [id])
  credential    Credential?    @relation(fields: [credentialId], references: [id])
  evidenceOf    Credential?    @relation("latestEvidence")
  downloadLinks DownloadLink[]

  @@unique([contractId, version])
  @@unique([credentialId, version])
  @@map("document_versions")
}

// ════════════════════════════════════════════════════════════════════════════
//  Eligibility  (spec §6.1)
// ════════════════════════════════════════════════════════════════════════════

enum EligibilityStatus {
  ELIGIBLE
  ELIGIBLE_WITH_GRACE
  /// Spec §6.1.1.1: a TRANSITION requirement is unmet but its deadline has not passed.
  ELIGIBLE_WITH_POLICY_WARNING
  INELIGIBLE
}

/// HR review of an uploaded document (spec §5.1.5, §5.2): a replacement stays
/// PENDING_REVIEW while the previously APPROVED version remains the evidence.
enum DocumentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Materialized state, one row per employee (spec §6.1 / V39).
model EligibilityState {
  employeeId     Int               @id @map("employee_id")
  status         EligibilityStatus
  reasons        Json              @default("[]") // [{code, message, templateId?}]
  calculatedAt   DateTime          @default(now()) @map("calculated_at") @db.Timestamptz
  updatedByEvent String?           @map("updated_by_event")
  logicVersion   Int               @default(1) @map("logic_version")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@map("eligibility_states")
}

/// Eligibility drift found by the consistency auditor (spec §10.8): the stored
/// state disagreed with a fresh evaluation (or was missing) and was corrected.
model ConsistencyAuditLog {
  id                 Int                @id @default(autoincrement())
  employeeId         Int                @map("employee_id")
  expectedStatus     EligibilityStatus  @map("expected_status")
  actualStatus       EligibilityStatus? @map("actual_status") // null = no stored state
  expectedReasons    Json               @map("expected_reasons") // reason keys "CODE:templateId"
  actualReasons      Json?              @map("actual_reasons")
  actualCalculatedAt DateTime?          @map("actual_calculated_at") @db.Timestamptz
  runDate            String             @map("run_date") // Riyadh date of the audit run
  detectedAt         DateTime           @default(now()) @map("detected_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([detectedAt])
  @@index([employeeId, detectedAt])
  @@map("consistency_audit_log")
}

/// Eligibility logic versions (spec §10.9 shadow mode, D-60). Each engine version
/// the release ships (modules/eligibility/logic.ts) has a row: exactly one ACTIVE
/// (its results are stored and shown), at most one SHADOW (run beside it on every
/// stored evaluation; differences go to eligibility_shadow_log), the rest RETIRED.
/// SQL: CHECK status; one ACTIVE and one SHADOW at most (partial unique indexes).
model EligibilityLogicVersion {
  version      Int       @id
  status       String
  shadowSince  DateTime? @map("shadow_since") @db.Timestamptz
  promotedAt   DateTime? @map("promoted_at") @db.Timestamptz
  promotedById Int?      @map("promoted_by_id")
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz
  retiredById  Int?      @map("retired_by_id")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  promotedBy User?                  @relation("logicPromoter", fields: [promotedById], references: [id], onDelete: Restrict)
  retiredBy  User?                  @relation("logicRetirer", fields: [retiredById], references: [id], onDelete: Restrict)
  findings   EligibilityShadowLog[]

  @@map("eligibility_logic_versions")
}

/// A stored evaluation where the SHADOW logic disagreed with the ACTIVE one
/// (spec §10.9). One row per version, nurse, day and pair of outcomes. HR decides
/// each: APPROVED (the new result is right) or REJECTED (it is wrong — the version
/// cannot be promoted). candidate_status ERROR = the new logic failed; never approvable.
/// SQL: decision fields all set or all empty; a decided row and any row cannot be deleted.
model EligibilityShadowLog {
  id               Int       @id @default(autoincrement())
  logicVersion     Int       @map("logic_version")
  employeeId       Int       @map("employee_id")
  evalDate         String    @map("eval_date") // Riyadh date evaluated
  activeVersion    Int       @map("active_version")
  activeStatus     String    @map("active_status")
  candidateStatus  String    @map("candidate_status")
  activeReasons    Json      @map("active_reasons")
  candidateReasons Json      @map("candidate_reasons")
  event            String
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  decision         String?
  decisionNote     String?   @map("decision_note")
  decidedById      Int?      @map("decided_by_id")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz

  version   EligibilityLogicVersion @relation(fields: [logicVersion], references: [version])
  employee  Employee                @relation(fields: [employeeId], references: [id])
  decidedBy User?                   @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([logicVersion, employeeId, evalDate, activeStatus, candidateStatus])
  @@index([logicVersion, decision])
  @@map("eligibility_shadow_log")
}

/// Emergency waiver (spec §6.1.2, rule L9).
/// SQL: CHECK expires_at <= created_at + interval '72 hours';
///      CHECK expires_at > created_at.
model CredentialWaiver {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  templateId Int      @map("template_id")
  waivedById Int      @map("waived_by_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz

  employee Employee           @relation(fields: [employeeId], references: [id])
  template CredentialTemplate @relation(fields: [templateId], references: [id])

  @@index([employeeId, expiresAt])
  @@map("credential_waivers")
}

// ════════════════════════════════════════════════════════════════════════════
//  Scheduling  (spec §6.2–6.3)
// ════════════════════════════════════════════════════════════════════════════

enum AssignmentStatus {
  Draft
  Published
  Cancelled
}

/// SQL: partial unique (employee_id, shift_date, shift_type) WHERE status <> 'Cancelled'
///      — one shift slot per nurse per day regardless of unit (rule S1).
model ShiftAssignment {
  id                   Int                @id @default(autoincrement())
  employeeId           Int                @map("employee_id")
  unitId               Int                @map("unit_id")
  shiftDate            DateTime           @map("shift_date") @db.Date
  shiftType            ShiftType          @map("shift_type")
  status               AssignmentStatus   @default(Draft)
  notes                String?
  /// Set when the assignment relied on a grace period or waiver (never silent — L8).
  eligibilityAtPublish EligibilityStatus? @map("eligibility_at_publish")
  createdById          Int?               @map("created_by_id")
  publishedById        Int?               @map("published_by_id")
  publishedAt          DateTime?          @map("published_at") @db.Timestamptz
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])

  @@index([unitId, shiftDate])
  @@index([shiftDate])
  @@map("shift_assignments")
}

// ════════════════════════════════════════════════════════════════════════════
//  Attendance  (spec §14.2 — clock events only; states/leave NOT ESTABLISHED)
// ════════════════════════════════════════════════════════════════════════════

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

model AttendanceEvent {
  id             Int                 @id @default(autoincrement())
  employeeId     Int                 @map("employee_id")
  eventType      AttendanceEventType @map("event_type")
  eventTimestamp DateTime            @map("event_timestamp") @db.Timestamptz
  source         String? // badge / PACS feed identifier
  deviceId       String?             @map("device_id")
  locationCode   String?             @map("location_code")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, eventTimestamp, eventType])
  @@index([source, createdAt(sort: Desc)])
  @@map("attendance_events")
}

// ════════════════════════════════════════════════════════════════════════════
//  Notifications  (spec §7)
// ════════════════════════════════════════════════════════════════════════════

enum NotificationType {
  CONTRACT
  CREDENTIAL
  COVERAGE
  ELIGIBILITY
  APPROVAL
  SECURITY
  SYSTEM
  ANNOUNCEMENT // D-69: one row per recipient account of a published announcement
}

enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// One row per recipient (spec §7.1, rule N2). eventKey dedups rescans (N3).
model Notification {
  id             Int                  @id @default(autoincrement())
  recipientId    Int                  @map("recipient_id")
  employeeId     Int?                 @map("employee_id") // subject of the event, if any
  type           NotificationType
  priority       NotificationPriority @default(MEDIUM)
  title          String
  message        String
  titleAr        String?              @map("title_ar")
  messageAr      String?              @map("message_ar")
  eventKey       String?              @map("event_key")
  readAt         DateTime?            @map("read_at") @db.Timestamptz
  /// Outbox state (spec §7.2, D-47): PENDING until the e-mail dispatcher sends it,
  /// or SKIPPED when e-mail is off or the recipient is inactive.
  emailStatus    DeliveryStatus       @default(PENDING) @map("email_status")
  emailAttempts  Int                  @default(0) @map("email_attempts")
  emailLastAt    DateTime?            @map("email_last_at") @db.Timestamptz
  emailLastError String?              @map("email_last_error") // relay response code/message only — no content
  /// D-66: Telegram outbox state. PENDING until the Telegram dispatcher runs; SKIPPED when the recipient
  /// has no linked chat (or is inactive). One message per recipient per run announces all its pending rows.
  telegramStatus    DeliveryStatus    @default(PENDING) @map("telegram_status")
  telegramAttempts  Int               @default(0) @map("telegram_attempts")
  telegramLastAt    DateTime?         @map("telegram_last_at") @db.Timestamptz
  /// Telegram's message_id of the message that announced this notification.
  telegramMessageId String?           @map("telegram_message_id")
  /// D-69: set exactly when type = ANNOUNCEMENT (SQL check).
  announcementId Int?                 @map("announcement_id")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  recipient    User          @relation(fields: [recipientId], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Restrict)

  @@unique([recipientId, eventKey])
  @@index([eventKey]) // expiry scan: who already has this event (N3)
  @@index([recipientId, readAt])
  @@index([emailStatus, emailLastAt])
  @@index([telegramStatus, telegramLastAt])
  @@index([announcementId])
  @@map("notifications")
}

enum AnnouncementKind {
  MEMO
  MEETING
  SEMINAR
}

/// D-69. DRAFT → PUBLISHED (a Supervisor to their own units) or DRAFT → PENDING_APPROVAL →
/// PUBLISHED | REJECTED (every HR / System Admin send); PUBLISHED → CANCELLED. Never edited once sent.
enum AnnouncementStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  CANCELLED
}

enum AudienceType {
  HOSPITAL
  DEPARTMENT
  UNIT
  PEOPLE
}

/// Memos, meeting schedules and seminar notices (D-69, owner decisions 2026-10-05). Written once and
/// fanned out at publication: one notifications row per recipient account (in-app, e-mail, Telegram
/// prompt) and one email_outbox row per contact address of staff without an account; both carry
/// event key `announcement:<id>`. Archived (not deleted) after expires_at; only drafts are deleted.
/// SQL checks: meeting/seminar times, https online link, audience ids, status timestamps.
model Announcement {
  id              Int                  @id @default(autoincrement())
  kind            AnnouncementKind
  status          AnnouncementStatus   @default(DRAFT)
  priority        NotificationPriority @default(LOW)
  title           String               @db.VarChar(150)
  body            String               @db.VarChar(5000)
  titleAr         String?              @map("title_ar") @db.VarChar(150)
  bodyAr          String?              @map("body_ar") @db.VarChar(5000)
  /// MEMO: the administration's own memo number.
  referenceNo     String?              @map("reference_no") @db.VarChar(50)
  /// MEETING / SEMINAR: start required (SQL check), end after it.
  startsAt        DateTime?            @map("starts_at") @db.Timestamptz
  endsAt          DateTime?            @map("ends_at") @db.Timestamptz
  location        String?              @db.VarChar(200)
  onlineUrl       String?              @map("online_url") @db.VarChar(500)
  /// SEMINAR: speaker and continuing-education hours (information only).
  speaker         String?              @db.VarChar(150)
  ceHours         Decimal?             @map("ce_hours") @db.Decimal(4, 1)
  audienceType    AudienceType         @map("audience_type")
  /// Department, unit or account ids for the audience type; empty for HOSPITAL.
  audienceIds     Int[]                @default([]) @map("audience_ids")
  /// Optional narrowing on top of the audience; empty = no filter. Roles apply to accounts only.
  roleFilter      AppRole[]            @default([]) @map("role_filter")
  positionFilter  String[]             @default([]) @map("position_filter")
  specialtyFilter String[]             @default([]) @map("specialty_filter")
  /// Frozen at publication.
  recipientCount  Int?                 @map("recipient_count")
  emailOnlyCount  Int?                 @map("email_only_count")
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz
  createdById     Int                  @map("created_by_id")
  publishedAt     DateTime?            @map("published_at") @db.Timestamptz
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz
  cancelledById   Int?                 @map("cancelled_by_id")
  cancelReason    String?              @map("cancel_reason") @db.VarChar(1000)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  createdBy     User           @relation("announcementCreator", fields: [createdById], references: [id])
  cancelledBy   User?          @relation("announcementCanceller", fields: [cancelledById], references: [id])
  notifications Notification[]

  @@index([status, expiresAt])
  @@index([createdById, status])
  @@map("announcements")
}

/// Telegram messages intercepted by the mock gateway (D-66, replacing the mock
/// SMS outbox of D-59): NOTIFICATION_DRIVER=mock saves each outgoing message here
/// instead of sending it; System Admins read it in the Dev Console. Purged after
/// MOCK_TELEGRAM_RETENTION_DAYS (it holds chat ids). Chat ids are text: they do
/// not fit a JavaScript number safely and are never calculated with.
model MockTelegramOutbox {
  id          Int      @id @default(autoincrement())
  chatId      String   @map("chat_id")
  messageText String   @map("message_text")
  /// null = plain text; "MarkdownV2"
  parseMode   String?  @map("parse_mode")
  status      String   @default("intercepted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@map("mock_telegram_outbox")
}

/// D-66: single-use links that connect an account to a Telegram chat
/// (https://t.me/<bot>?start=<token>). Only the SHA-256 is stored. Issued by the
/// account itself or by HR / a System Admin for it; valid 15 minutes; a new link
/// replaces the account's open ones.
model TelegramLinkToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  issuedById Int       @map("issued_by_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user     User @relation("telegramLinkOwner", fields: [userId], references: [id])
  issuedBy User @relation("telegramLinkIssuer", fields: [issuedById], references: [id])

  @@index([userId, usedAt])
  @@map("telegram_link_tokens")
}

/// E-mails to people without an account (spec §3.6: the break-glass alert to the
/// CEO and IT Director; D-47). Sent by the same dispatcher as notification e-mails.
model EmailOutbox {
  id        Int                  @id @default(autoincrement())
  toAddress String               @map("to_address")
  subject   String
  bodyText  String               @map("body_text")
  bodyHtml  String               @map("body_html")
  priority  NotificationPriority @default(MEDIUM)
  eventKey  String               @map("event_key")
  status    DeliveryStatus       @default(PENDING)
  attempts  Int                  @default(0)
  lastAt    DateTime?            @map("last_at") @db.Timestamptz
  lastError String?              @map("last_error")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@unique([toAddress, eventKey])
  @@index([status, lastAt])
  @@map("email_outbox")
}

// ════════════════════════════════════════════════════════════════════════════
//  Audit  (spec §9.1) — written ONLY through fn_append_audit_entry()
// ════════════════════════════════════════════════════════════════════════════

model AuditEntry {
  id           BigInt   @id @default(autoincrement())
  actorUserId  Int?     @map("actor_user_id") // null = system job
  action       String
  resource     String
  resourceId   String?  @map("resource_id")
  changes      Json     @default("{}")
  requestId    String?  @map("request_id")
  priority     String   @default("NORMAL") // NORMAL | HIGH (waivers, break-glass, role changes)
  previousHash String?  @map("previous_hash")
  hash         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([resource, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_entries")
}

// ════════════════════════════════════════════════════════════════════════════
//  Platform  (spec §9.5 idempotency, §10.3 worker leases)
// ════════════════════════════════════════════════════════════════════════════

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Failed sign-in counters shared by every API instance (spec §3.3; decision D-46).
/// Fixed window per key; keys are SHA-256 hashes of "acct:<email>" or "ip:<address>",
/// so no e-mail or address is stored. Expired rows are swept by the API.
model LoginThrottle {
  keyHash String   @id @map("key_hash")
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@index([resetAt])
  @@map("login_throttle")
}

/// Registration invitations (spec §3.2). Single-use, 72 hours; only a SHA-256 hash
/// of the token is stored and the token itself only ever travels in the e-mail.
/// Issuing a new invitation revokes the employee's earlier unused ones.
model Invitation {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  email       String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdById Int       @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  userId      Int?      @unique @map("user_id") // the account the claim created

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User     @relation("issuer", fields: [createdById], references: [id])
  user      User?    @relation("claimant", fields: [userId], references: [id])

  @@index([employeeId, createdAt])
  @@map("invitations")
}

/// Password reset links (decision D-50). SELF: requested on the sign-in page, staff
/// accounts only, 30 minutes. ASSISTED: sent by HR / a System Admin, any active
/// non-break-glass account, 24 hours. Only a SHA-256 of the token is stored.
model PasswordReset {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  mode          String // SELF | ASSISTED (CHECK in SQL)
  tokenHash     String    @unique @map("token_hash")
  requestedById Int?      @map("requested_by_id") // null for SELF
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  usedAt        DateTime? @map("used_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz

  user        User  @relation("resetFor", fields: [userId], references: [id])
  requestedBy User? @relation("resetIssuer", fields: [requestedById], references: [id])

  @@index([userId, createdAt])
  @@map("password_resets")
}

/// D-67: a change of an account's sign-in e-mail, applied only when the link
/// sent to the NEW address is opened (30 minutes, single use, SHA-256 stored).
/// SELF needs the current password; ASSISTED is HR / a System Admin for an
/// account in scope. A new request revokes the open one.
model EmailChange {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  mode          String // SELF | ASSISTED (CHECK in SQL)
  oldEmail      String    @map("old_email")
  newEmail      String    @map("new_email")
  tokenHash     String    @unique @map("token_hash")
  requestedById Int       @map("requested_by_id")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  usedAt        DateTime? @map("used_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz

  user        User @relation("emailChangeFor", fields: [userId], references: [id])
  requestedBy User @relation("emailChangeIssuer", fields: [requestedById], references: [id])

  @@index([userId, createdAt])
  @@map("email_changes")
}

/// MFA (spec §3.5): one authenticator per account. Pending until the first
/// code confirms it; the seed is encrypted (lib/secret-box.ts).
model MfaFactor {
  userId       Int       @id @map("user_id")
  secretEnc    String    @map("secret_enc")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz
  /// The 30-second step of the last accepted code: a code works once.
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("mfa_factors")
}

/// Single-use recovery codes; only a SHA-256 is stored.
model MfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// The second sign-in step: issued after a correct password, redeemed with a
/// code (VERIFY) or by setting up the authenticator (ENROLL). SHA-256 only.
model MfaChallenge {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  purpose   String // VERIFY | ENROLL (CHECK in SQL)
  tokenHash String    @unique @map("token_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("mfa_challenges")
}

/// Short-lived, single-use link to one stored document (spec §5.3.1, D-53):
/// issued only after the same authorisation as a download, redeemed once
/// within 60 seconds by a plain browser request. Only a SHA-256 is stored.
model DownloadLink {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique @map("token_hash")
  documentId Int       @map("document_id")
  userId     Int       @map("user_id")
  inline     Boolean   @default(true)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  document DocumentVersion @relation(fields: [documentId], references: [id])
  user     User            @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("download_links")
}

/// Request-level forensic log (spec §9.2): one row per API request — who,
/// what, when, from where, and the outcome. No bodies, no query strings: the
/// body appears only as a keyed hash with secrets removed. Written after the
/// response, in batches, never blocking or failing a request. Append-only for
/// the runtime role except the retention purge (ops/db/02_grants.sql).
model RequestLogEntry {
  id            BigInt   @id @default(autoincrement())
  requestId     String   @map("request_id") @db.VarChar(128)
  at            DateTime @map("at") @db.Timestamptz
  actorUserId   Int?     @map("actor_user_id")
  actorRoles    String?  @map("actor_roles") @db.VarChar(100)
  sessionFamily String?  @map("session_family") @db.VarChar(64)
  method        String   @db.VarChar(10)
  path          String   @db.VarChar(500)
  statusCode    Int      @map("status_code") @db.SmallInt
  durationMs    Int      @map("duration_ms")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  paramsHash    String?  @map("params_hash") @db.Char(64)
  errorCode     String?  @map("error_code") @db.VarChar(100)

  @@index([at])
  @@index([actorUserId, at])
  @@index([requestId])
  @@map("request_audit_log")
}

/// D-54: each employee's data key for sensitive fields, wrapped by
/// PDPL_FIELD_ENCRYPTION_KEY. Erasure (spec §8.3.3) destroys it: wrappedKey
/// null, destroyedAt set — every value sealed with it becomes unreadable.
model EmployeeKey {
  employeeId  Int       @id @map("employee_id")
  wrappedKey  String?   @map("wrapped_key")
  keyVersion  Int       @default(1) @map("key_version")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  destroyedAt DateTime? @map("destroyed_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_keys")
}

/// Spec §8.3.2: the documented lawful basis per category of sensitive data.
/// A sensitive value is stored only while its category has an active row.
model ProcessingRegister {
  id            Int      @id @default(autoincrement())
  dataCategory  String   @map("data_category")
  lawfulBasis   String   @map("lawful_basis")
  purpose       String
  retentionRule String   @map("retention_rule")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById   Int?     @map("updated_by_id")

  @@unique([dataCategory, lawfulBasis])
  @@map("processing_register")
}

/// Spec §8.3.4 blind index: HMAC of each sensitive identifier, for exact search.
model PdplIdentifierIndex {
  credentialId Int    @map("credential_id")
  category     String
  digest       String @db.Char(64)
  keyVersion   Int    @default(1) @map("key_version")

  credential Credential @relation(fields: [credentialId], references: [id])

  @@id([credentialId, category])
  @@index([digest])
  @@map("pdpl_identifier_index")
}

/// The Data Protection Officer's sign-off of the processing register (B-18):
/// who reviewed it, when, and the register exactly as reviewed. Never changed.
model ProcessingRegisterSignOff {
  id               Int      @id @default(autoincrement())
  reviewedById     Int      @map("reviewed_by_id")
  reviewerTitle    String   @map("reviewer_title")
  note             String?
  registerSnapshot Json     @map("register_snapshot")
  reviewedAt       DateTime @default(now()) @map("reviewed_at") @db.Timestamptz

  reviewedBy User @relation(fields: [reviewedById], references: [id])

  @@index([reviewedAt(sort: Desc)])
  @@map("processing_register_sign_offs")
}

/// Data-subject rights requests (spec §8.3.3, D-55): access, portability,
/// rectification and erasure. Rows are never deleted — they are the record.
model DataSubjectRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @map("employee_id")
  requestType     String    @map("request_type") // ACCESS | PORTABILITY | RECTIFICATION | ERASURE
  status          String    @default("RECEIVED") // RECEIVED | IN_REVIEW | APPROVED | REJECTED | COMPLETED
  details         String?
  requestedById   Int       @map("requested_by_id")
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  reviewedById    Int?      @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  decidedById     Int?      @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz
  decisionNote    String?   @map("decision_note")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  /// Erasure evidence: when the employee's key was destroyed, and when the last backup holding the old ciphertext expires.
  keyDestroyedAt  DateTime? @map("key_destroyed_at") @db.Timestamptz
  backupsExpireAt DateTime? @map("backups_expire_at") @db.Timestamptz
  documentsErased Int?      @map("documents_erased")

  employee    Employee @relation(fields: [employeeId], references: [id])
  requestedBy User     @relation("dsrRequester", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("dsrReviewer", fields: [reviewedById], references: [id])
  decidedBy   User?    @relation("dsrDecider", fields: [decidedById], references: [id])

  @@index([status, requestedAt(sort: Desc)])
  @@index([employeeId, requestedAt(sort: Desc)])
  @@map("data_subject_requests")
}

model IdempotencyKey {
  id                       Int               @id @default(autoincrement())
  key                      String
  actorUserId              Int               @map("actor_user_id")
  operation                String
  requestPath              String            @map("request_path")
  requestHash              String            @map("request_hash")
  status                   IdempotencyStatus
  processingLeaseExpiresAt DateTime?         @map("processing_lease_expires_at") @db.Timestamptz
  responseCode             Int?              @map("response_code")
  responseBody             Json?             @map("response_body") // identifiers only — no PII
  responseHash             String?           @map("response_hash")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz
  completedAt              DateTime?         @map("completed_at") @db.Timestamptz
  expiresAt                DateTime          @map("expires_at") @db.Timestamptz

  @@unique([key, actorUserId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// SQL: CHECK lease_seconds BETWEEN 30 AND 3600; CHECK expires_at > acquired_at (V49).
model WorkerLease {
  jobName      String   @id @map("job_name")
  holderId     String   @map("holder_id") @db.Uuid
  acquiredAt   DateTime @default(now()) @map("acquired_at") @db.Timestamptz
  heartbeatAt  DateTime @default(now()) @map("heartbeat_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  leaseSeconds Int      @default(300) @map("lease_seconds")

  @@index([expiresAt])
  @@map("worker_leases")
}

enum JobRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One row per scheduled run. `runKey` (job + period, e.g. daily-transition:2026-09-23)
/// is unique, so a period runs at most once to completion and a missed period is visible (N4).
model JobRun {
  id         Int          @id @default(autoincrement())
  jobName    String       @map("job_name")
  runKey     String       @unique @map("run_key")
  status     JobRunStatus @default(RUNNING)
  startedAt  DateTime     @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz
  attempts   Int          @default(1)
  summary    Json?
  error      String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}

/// D-63: another system (the HIS, payroll) calling the FHIR API without a
/// person signed in — OAuth 2.0 client credentials. The secret is shown once
/// and stored only as its SHA-256 (it is 256 random bits, so a slow hash adds
/// nothing). A new secret raises secretVersion, which ends every token issued
/// under the old one; a revoked client stays for the record.
model ApiClient {
  id              Int       @id @default(autoincrement())
  clientId        String    @unique @map("client_id")
  name            String
  scopes          String[]
  secretHash      String    @map("secret_hash")
  secretVersion   Int       @default(1) @map("secret_version")
  createdById     Int       @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  secretRotatedAt DateTime? @map("secret_rotated_at") @db.Timestamptz
  lastTokenAt     DateTime? @map("last_token_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  revokedById     Int?      @map("revoked_by_id")

  createdBy User  @relation("apiClientCreator", fields: [createdById], references: [id])
  revokedBy User? @relation("apiClientRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@map("api_clients")
}

/// Spec §5.4 (D-64): every SCFHS licence check — what SCFHS answered and what
/// the system did. The registration number is kept only as its last four
/// characters (D-54); the response only as its SHA-256.
model ScfhsCheck {
  id                BigInt    @id @default(autoincrement())
  credentialId      Int       @map("credential_id")
  employeeId        Int       @map("employee_id")
  regNumberHint     String    @map("reg_number_hint")
  requestType       String    @map("request_type")
  driver            String
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz
  responseStatus    String    @map("response_status")
  scfhsExpiryDate   String?   @map("scfhs_expiry_date")
  scfhsSpecialty    String?   @map("scfhs_specialty")
  scfhsLicenseStatus String?  @map("scfhs_license_status")
  responseHash      String?   @map("response_hash")
  errorMessage      String?   @map("error_message")
  matched           Boolean?
  discrepancies     String[]
  action            String
  actorUserId       Int?      @map("actor_user_id")

  credential Credential @relation(fields: [credentialId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([credentialId, requestedAt(sort: Desc)])
  @@index([responseStatus, requestedAt(sort: Desc)])
  @@map("scfhs_verification_log")
}

/// D-64: the simulated SCFHS registry the mock gateway answers from (Dev
/// Console). Synthetic demonstration entries only — never a copy of real data.
model MockScfhsRegistry {
  registrationNumber String   @id @map("registration_number")
  status             String
  expiryDate         String?  @map("expiry_date")
  specialty          String?
  note               String?
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("mock_scfhs_registry")
}
